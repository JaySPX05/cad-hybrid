# ---------- Data: never commit patient data ----------
# Keep only the folder skeleton (.gitkeep), the data README and the data register.
data/raw/**
!data/raw/**/
!data/raw/**/.gitkeep
data/interim/**
!data/interim/**/
!data/interim/**/.gitkeep
data/processed/**
!data/processed/**/
!data/processed/**/.gitkeep

